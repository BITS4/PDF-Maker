# Optional build-time crash reporting. Gradle does not load this file automatically.
# Default builds keep telemetry disabled; both values must be supplied explicitly for a release build to opt in.
SENTRY_ENABLED=false
SENTRY_DSN=

# Android SDK discovery belongs in an untracked local.properties file or ANDROID_HOME.
# Signing credentials belong in a local keystore or GitHub Actions secrets, never in this file.
